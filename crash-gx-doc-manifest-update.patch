+#include "runtime/gs/ps2_gif_arbiter.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+// submitAndDrain must be indistinguishable from submit()+drain(): same packets,
+// same bytes, same order, also when a queue is pending or processing re-enters.
+namespace {
+struct Seen { std::vector<std::vector<uint8_t>> packets; };
+void Check(bool ok, const char *what) { if (!ok) { std::fprintf(stderr, "FAIL: %s\n", what); std::exit(1); } }
+}
+
+int main()
+{
+    std::mt19937 rng(1234);
+    Seen a, b;
+    GifArbiter ref([&](const uint8_t *d, uint32_t n) { a.packets.emplace_back(d, d + n); });
+    GifArbiter fast([&](const uint8_t *d, uint32_t n) { b.packets.emplace_back(d, d + n); });
+    std::vector<uint8_t> buf(16 * 1024);
+    for (unsigned i = 0; i < 20000; ++i)
+    {
+        const uint32_t qw = 1 + rng() % 40; // up to 640 B
+        for (uint32_t j = 0; j < qw * 16; ++j) buf[j] = uint8_t(rng());
+        if (rng() % 4 == 0) { buf[7] = uint8_t((buf[7] & 0x03) | (2u << 2)); } // IMAGE-ish tag byte for path3 detection
+        const GifPathId path = GifPathId(1 + rng() % 3);
+        const bool direct = rng() % 3 == 0;
+        if (rng() % 7 == 0)
+        {   // queue several then drain: both arbiters take the same legacy route
+            ref.submit(path, buf.data(), qw * 16, direct);
+            fast.submit(path, buf.data(), qw * 16, direct);
+            ref.submit(GifPathId::Path3, buf.data(), qw * 16, false);
+            fast.submit(GifPathId::Path3, buf.data(), qw * 16, false);
+            ref.drain(); fast.drain();
+        }
+        ref.submit(path, buf.data(), qw * 16, direct); ref.drain();
+        fast.submitAndDrain(path, buf.data(), qw * 16, direct);
+        Check(ref.empty() && fast.empty(), "queues empty");
+    }
+    // Packets above the scratch limit take the legacy route and must stay identical too.
+    for (unsigned i = 0; i < 200; ++i)
+    {
+        const uint32_t qw = 200 + rng() % 800; // 3.2-16 KB
+        for (uint32_t j = 0; j < qw * 16; ++j) buf[j] = uint8_t(rng());
+        ref.submit(GifPathId::Path3, buf.data(), qw * 16); ref.drain();
+        fast.submitAndDrain(GifPathId::Path3, buf.data(), qw * 16);
+    }
+    Check(a.packets == b.packets, "identical packet sequence and bytes");
+    Check(!a.packets.empty(), "packets processed");
+
+    // Snapshot semantics: later writes to the source must not reach processing.
+    std::vector<uint8_t> src(32, 0x11); std::vector<uint8_t> got;
+    GifArbiter snap([&](const uint8_t *d, uint32_t n) { std::memset(src.data(), 0x22, src.size()); got.assign(d, d + n); });
+    snap.submitAndDrain(GifPathId::Path1, src.data(), 32);
+    Check(got == std::vector<uint8_t>(32, 0x11), "snapshot taken before processing");
+
+    // Re-entrant submit during processing uses the legacy path and keeps all data.
+    unsigned calls = 0; bool reenter = true; GifArbiter *self = nullptr;
+    GifArbiter re([&](const uint8_t *, uint32_t) { ++calls; if (reenter) { reenter = false; uint8_t t[16] = {}; self->submit(GifPathId::Path1, t, 16); } });
+    self = &re;
+    uint8_t one[16] = {};
+    re.submitAndDrain(GifPathId::Path1, one, 16);
+    re.drain();
+    Check(calls == 2, "re-entrant packet processed exactly once");
+
+    // Informational timing.
+    unsigned long sink = 0;
+    GifArbiter t1([&](const uint8_t *d, uint32_t n) { sink += d[0] + n; }), t2([&](const uint8_t *d, uint32_t n) { sink += d[0] + n; });
+    uint8_t pkt[64] = {1};
+    auto t0 = std::chrono::steady_clock::now();
+    for (unsigned i = 0; i < 2000000; ++i) { t1.submit(GifPathId::Path2, pkt, 64); t1.drain(); }
+    auto t1e = std::chrono::steady_clock::now();
+    for (unsigned i = 0; i < 2000000; ++i) t2.submitAndDrain(GifPathId::Path2, pkt, 64);
+    auto t2e = std::chrono::steady_clock::now();
+    std::printf("submit+drain %.1f ms, submitAndDrain %.1f ms (2M x 64B, host, sink=%lu)\n",
+        std::chrono::duration<double, std::milli>(t1e - t0).count(), std::chrono::duration<double, std::milli>(t2e - t1e).count(), sink);
+    std::puts("gif arbiter checks passed");
+    return 0;
+}
