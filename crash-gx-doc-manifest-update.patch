+void GifArbiter::submitAndDrain(GifPathId pathId, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl)
+{
+    if (!data || sizeBytes < 16 || !m_processFn)
+        return;
+
+    // Large packets (image uploads) keep the allocate/free route: a persistent scratch
+    // buffer sized for them would pin memory that the Wii cannot spare.
+    if (!m_queue.empty() || m_inFlight || sizeBytes > kScratchMaxBytes)
+    {
+        submit(pathId, data, sizeBytes, path2DirectHl);
+        drain();
+        return;
+    }
+
+    // Snapshot like submit() does, so processing cannot observe later writes to the source.
+    m_scratch.assign(data, data + sizeBytes);
+    m_inFlight = true;
+    try
+    {
+        m_processFn(m_scratch.data(), sizeBytes);
+    }
+    catch (...)
+    {
+        m_inFlight = false;
+        throw;
+    }
+    m_inFlight = false;
+}
