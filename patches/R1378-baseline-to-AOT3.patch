+                st->lo.ud1 = sext32(0x80000000u);
+                st->hi.ud1 = 0;
+            } else if (rt32 != 0) {
+                st->lo.ud1 = sext32((uint32_t)((int32_t)rs32 / (int32_t)rt32));
+                st->hi.ud1 = sext32((uint32_t)((int32_t)rs32 % (int32_t)rt32));
+            } else {
+                st->lo.ud1 = (int32_t)rs32 < 0 ? 1 : UINT64_MAX;
