+                    if (!(destmask & (0x8u >> lane))) continue;
+                    uint32_t ua = vu0_vf_read_lane(st, fs, (uint32_t)lane);
+                    uint32_t ub = vu0_vf_read_lane(st, ft, (uint32_t)lane);
