+            return 1;
+        case VUL_IBGTZ:
+            if (vu_read_vi16_signed(vi, rs) > 0)  { *branch_delay = 2u; *branch_target = (uint32_t)((int32_t)pc + 8 + off11 * 8); }
+            return 1;
+        case VUL_IBLEZ:
+            if (vu_read_vi16_signed(vi, rs) <= 0) { *branch_delay = 2u; *branch_target = (uint32_t)((int32_t)pc + 8 + off11 * 8); }
+            return 1;
+        case VUL_IBGEZ:
+            if (vu_read_vi16_signed(vi, rs) >= 0) { *branch_delay = 2u; *branch_target = (uint32_t)((int32_t)pc + 8 + off11 * 8); }
+            return 1;
