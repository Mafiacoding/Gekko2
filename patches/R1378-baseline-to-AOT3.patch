+                    else if (bc_lane == 2) { op_kind = 6; ub = vu0_vi_read(st, 21); } /* VMULi */
+                    else { op_kind = 5; ub = vu0_vi_read(st, 21); }                    /* VMINIi */
+                } else {
+                    op_kind = base_op;
+                    ub = vu0_vf_read_lane(st, ft, bc_lane);
+                }
