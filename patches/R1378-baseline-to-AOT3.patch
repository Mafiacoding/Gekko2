+    case 0x0D: /* ORI */   if (rt) GPR(rt) = GPR(rs) | uimm; break;
+    case 0x0E: /* XORI */  if (rt) GPR(rt) = GPR(rs) ^ uimm; break;
+    case 0x0F: /* LUI */   if (rt) GPR(rt) = uimm << 16; break;
