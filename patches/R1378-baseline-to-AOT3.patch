+    case 0x2A: /* SWL */ {
+        static const uint32_t SWL_MASK[4]  = { 0xffffff00u, 0xffff0000u, 0xff000000u, 0x00000000u };
+        static const uint8_t  SWL_SHIFT[4] = { 24, 16, 8, 0 };
