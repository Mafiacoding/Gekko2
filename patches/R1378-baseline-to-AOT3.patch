+_,unitoff=layout('core/hw/vu.h','vu1_state_t',['vi','mem','micro','xgkick_pending','xgkick_addr','instructions_executed','pipeline'])
+_,gifoff=layout('core/hw/gif.h','gif_state_t',['ctx1_xyoffset_x','gif_path1_transfers'])
