+    case 0x28: /* SB */ iop_mem_write8(st, rs32 + imm, (uint8_t)GPR(rt)); break;
+    case 0x29: /* SH */ iop_mem_write16(st, rs32 + imm, (uint16_t)GPR(rt)); break;
+    case 0x2B: /* SW */ iop_mem_write32(st, rs32 + imm, GPR(rt)); break;
