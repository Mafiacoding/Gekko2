+        uint32_t shift = addr & 7u;
+        uint64_t mem = ee_mem_read64(st, addr & ~7u);
+        ee_mem_write64(st, addr & ~7u, (GPR(rt) >> SDL_SHIFT[shift]) | (mem & SDL_MASK[shift]));
