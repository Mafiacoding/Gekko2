+static context start,reference,current;
+static void put(uint8_t *p,uint32_t w){for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(w>>(8*i));}
+static void run(context *c,unsigned mask){for(unsigned i=0;i<3;i++)if(vu_micro_step_pipeline(c->vf,c->vi,c->acc,c->mem,mask,c->micro,mask,&c->pc,&c->bd,&c->bt,&c->ed,&c->retired,&c->unknown,&c->pipeline))break;}
