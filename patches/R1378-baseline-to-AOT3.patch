+        uint32_t shift = addr & 3;
+        uint32_t mem = ee_mem_read32(st, addr & ~3u);
+        ee_mem_write32(st, addr & ~3u, (rt32 >> SWL_SHIFT[shift]) | (mem & SWL_MASK[shift]));
