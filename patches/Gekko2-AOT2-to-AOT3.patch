+/* GPL-3.0-or-later. Independent VU issue-clock and GIF boundary oracles. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "core/hw/vu.h"
+#include "core/hw/gif.h"
+#include "core/hw/gs_mem.h"
