; Gekko2 Wii U GS renderer - depth upload pixel shader: writes the depth sampled from a FLOAT_R32 texture
; (GS Z normalised to 0..1 by the CPU) into the depth buffer. Colour writes are masked off by the caller.
; Z is exported through pixel export 61 (R600 family); SQ_PGM_EXPORTS_PS.EXPORT_MODE bit 0 = Z export,
; bits 1+ = number of colour exports, so 3 = Z + one colour.
; $MODE = "UniformRegister"

; $SAMPLER_VARS[0].name = "sampler_0"
; $SAMPLER_VARS[0].type = "SAMPLER2D"
; $SAMPLER_VARS[0].location = 0

; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1

; $SQ_PGM_EXPORTS_PS.EXPORT_MODE = 3
; $DB_SHADER_CONTROL.Z_EXPORT_ENABLE = true
; $DB_SHADER_CONTROL.Z_ORDER = "LATE_Z"

00 TEX: ADDR(32) CNT(1) VALID_PIX
      0  SAMPLE R1, R1.xy0x, t0, s0
01 EXP: PIX0, R0
02 EXP_DONE: PIX61, R1.xxxx
END_OF_PROGRAM
