; Gekko2 Wii U GS renderer - frame buffer feedback copy (gx2_gs_texture_from_target): texel RGB unchanged,
; alpha = texel alpha * col.x + (texel RGB != 0 ? col.y : col.z). col is the vertex colour:
;   (1, 0, 0) copies the alpha, (0, a, a) sets a constant (TEX0.TCC = 0, PSMCT24 + TEXA.TA0),
;   (0, ta0, 0) is PSMCT24 with TEXA.AEM (black texels transparent).
; $MODE = "UniformRegister"

; $SAMPLER_VARS[0].name = "sampler_0"
; $SAMPLER_VARS[0].type = "SAMPLER2D"
; $SAMPLER_VARS[0].location = 0

; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1

00 TEX: ADDR(48) CNT(1) VALID_PIX
      0  SAMPLE R1, R1.xy0x, t0, s0
01 ALU: ADDR(32) CNT(7)
      1  x: MAX R2.x, R1.x, R1.y
      2  x: MAX R2.x, R2.x, R1.z
      3  w: CNDGT R2.w, R2.x, R0.y, R0.z
      4  x: MOV R3.x, R1.x
         y: MOV R3.y, R1.y
         z: MOV R3.z, R1.z
         w: MULADD R3.w, R1.w, R0.x, R2.w
02 EXP_DONE: PIX0, R3
END_OF_PROGRAM
